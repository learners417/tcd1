# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  LAS VARIABLES DE LA APP                                                 ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# Están en tres grupos, por lo que pasa si falta cada una.
#
# Las VITE_ las lee el navegador y entran en el paquete publicado: ahí NO va
# ninguna clave secreta. Las demás las lee el servidor (las rutas de api/) y se
# cargan en Vercel → Settings → Environment Variables, nunca en este archivo.


# ── 1 · SIN ESTAS DOS, NADIE PUEDE ENTRAR ──────────────────────────────────
#
# Son las únicas obligatorias para que un cliente inicie sesión. Sin ellas la
# app arranca en modo offline y el login responde que no se pudo entrar.
#
# Dónde salen: Supabase → Project Settings → API.
# La `anon key` es pública por diseño: la protege RLS, no el secreto.
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."


# ── 2 · SIN ESTAS, LA APP ANDA PERO ALGO QUEDA APAGADO ─────────────────────

# El Mentor y los entrenadores. Sin ninguna de las dos, el cliente lee que la
# IA no está disponible y qué hacer mientras tanto — no se rompe nada.
# Van en Vercel, del lado del servidor.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Opcionales: cuál usar y hasta dónde. Si no se ponen, van los valores por
# defecto del código.
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=
DEEPSEEK_MODEL=
DEEPSEEK_MAX_TOKENS=
FORCE_AI_PROVIDER=
# Imágenes de los creativos (cascada: OpenAI primero, Gemini de respaldo).
OPENAI_API_KEY=
GEMINI_API_KEY=

# Lo que el servidor necesita para escribir en nombre del sistema: los avisos,
# los créditos, el cierre de mes. Sin esto, los cron de Vercel no corren.
# La service role key SALTEA RLS: nunca con prefijo VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Cobro desde la app. Sin esto, el botón de comprar créditos no funciona; el
# resto del programa sigue igual.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV="sandbox"
PAYPAL_WEBHOOK_ID=
# Los créditos se pueden apagar enteros mientras no se cobre desde la app.
VITE_CREDITS_ENABLED="false"
CREDITS_ENABLED="false"

# El alta automática desde GHL: cuando alguien paga, queda creado en la app.
# Sin esto, las altas se hacen a mano desde el Admin.
GHL_WEBHOOK_SECRET=
ALTA_NUMERO_KEY=
ALTA_REDIRECT_URL=
TCD_INTEGRATION_KEY=
MCD_BASE_URL=


# ── 3 · SIN ESTAS NO SE PIERDE NADA ────────────────────────────────────────
#
# Sentry avisa de los errores que les pasan a los clientes. Sin esto la app
# funciona igual; lo que se pierde es enterarse.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT="production"
SENTRY_DSN=
SENTRY_ENVIRONMENT="production"

# La versión que la app muestra en su pie. Vercel la completa sola.
VITE_APP_VERSION=
