# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  LAS VARIABLES DE LA APP                                                 ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# Están en tres grupos, por lo que pasa si falta cada una.
#
# Las VITE_ las lee el navegador y entran en el paquete publicado: ahí NO va
# ninguna clave secreta. Las demás las lee el servidor (las rutas de api/) y se
# cargan en Vercel → Settings → Environment Variables, nunca en este archivo.


# ── 1 · SIN ESTAS DOS, NADIE PUEDE ENTRAR ──────────────────────────────────
#
# Son las únicas obligatorias para que un cliente inicie sesión. Sin ellas la
# app arranca en modo offline y el login responde que no se pudo entrar.
#
# Dónde salen: Supabase → Project Settings → API.
# La `anon key` es pública por diseño: la protege RLS, no el secreto.
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."


# ── 2 · SIN ESTAS, LA APP ANDA PERO ALGO QUEDA APAGADO ─────────────────────

# La carpeta donde viven los cinco libros. Sin esto el estante muestra cada
# libro con su nombre y su bajada, y sin el botón «Abrirlo»: el cliente ve los
# libros y no los puede abrir desde la app. El link NO se escribe en el repo.
VITE_LIBROS_URL=

# El Mentor y los entrenadores. Sin ninguna de las dos, el cliente lee que la
# IA no está disponible y qué hacer mientras tanto — no se rompe nada.
# Van en Vercel, del lado del servidor.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Opcionales: cuál usar y hasta dónde. Si no se ponen, van los valores por
# defecto del código.
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=
DEEPSEEK_MODEL=
DEEPSEEK_MAX_TOKENS=
FORCE_AI_PROVIDER=
# Imágenes de los creativos (cascada: OpenAI primero, Gemini de respaldo).
OPENAI_API_KEY=
GEMINI_API_KEY=

# Lo que el servidor necesita para escribir en nombre del sistema: los avisos,
# los créditos, el cierre de mes. Sin esto, los cron de Vercel no corren.
# La service role key SALTEA RLS: nunca con prefijo VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# La anon key del lado del servidor: la usa el cliente que actúa EN NOMBRE del
# que llama (con su JWT), que es lo contrario de la service role. Si no está,
# se cae a VITE_SUPABASE_ANON_KEY, que es la misma clave.
SUPABASE_ANON_KEY=
CRON_SECRET=

# ── LOS ENLACES POR DONDE ENTRA LA PLATA ───────────────────────────────────
#
# Nueve enlaces, todos order forms de GHL, todos opcionales en el mismo
# sentido: con la variable vacía el botón NO desaparece — cae al WhatsApp de
# siempre. Así que si no las cargas nada se rompe y nada se cobra solo: cada
# venta sigue pasando por una conversación. Son las últimas nueve que
# quedaron fuera de esta lista hasta el 17 de noviembre, y por eso se escriben
# con lo que abre cada una.
#
# Los tres del candado de los pilares (src/lib/planes.ts):
VITE_CHECKOUT_AMARILLO=
VITE_CHECKOUT_VERDE=
VITE_CHECKOUT_NEGRO=
# Los tres del candado del día 5, la oferta que sigue (src/lib/laOfertaQueSigue.ts):
VITE_CHECKOUT_BASE=
VITE_CHECKOUT_ASCENSO=
VITE_CHECKOUT_INSTALACION=
# Los tres pases de renovación, al mes (src/lib/renovacion.ts):
VITE_RENOVACION_APP=
VITE_RENOVACION_GRUPAL=
VITE_RENOVACION_PRIVADO=


# Cobro desde la app. Sin esto, el botón de comprar créditos no funciona; el
# resto del programa sigue igual.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV="sandbox"
PAYPAL_WEBHOOK_ID=
# Los créditos se pueden apagar enteros mientras no se cobre desde la app.
VITE_CREDITS_ENABLED="false"
CREDITS_ENABLED="false"

# El alta automática desde GHL: cuando alguien paga, queda creado en la app.
# Sin esto, las altas se hacen a mano desde el Admin.
GHL_WEBHOOK_SECRET=
# Los tres avisos que la app le manda a GHL: tres días sin entrar, día 5 hecho,
# camino completo. Se arma en GHL con un Workflow de webhook de entrada y la
# dirección se pega acá. Sin esto los avisos se calculan y no salen; ninguna
# dirección de GHL vive en el repo.
GHL_AVISOS_WEBHOOK=
# La transcripción de las llamadas entra sola desde Fathom. La ruta rechaza
# con 401 TODO lo que llegue mientras esta variable esté vacía —falla cerrada,
# no abierta—, así que sin cargarla el webhook queda configurado en Fathom y
# ninguna transcripción entra nunca. El mismo valor se pega en Fathom, en el
# header `x-fathom-secret` (o como `?clave=` si su plan no deja mandar header).
FATHOM_WEBHOOK_SECRET=
ALTA_NUMERO_KEY=
ALTA_REDIRECT_URL=
TCD_INTEGRATION_KEY=
MCD_BASE_URL=


# ── 3 · SIN ESTAS NO SE PIERDE NADA ────────────────────────────────────────
#
# Sentry avisa de los errores que les pasan a los clientes. Sin esto la app
# funciona igual; lo que se pierde es enterarse.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT="production"
SENTRY_DSN=
SENTRY_ENVIRONMENT="production"

# La versión que la app muestra en su pie. Vercel la completa sola.
VITE_APP_VERSION=

# Lo que cuesta cada modelo, en USD por millón de tokens, como JSON. Sin esto
# el motor usa los precios escritos en api/_lib/router.ts, que son de
# noviembre de 2026 y no están confirmados con cada proveedor: es lo que el
# Panel del Motor de IA dice cuando avisa «se corrigen cargando la variable
# PRECIOS_IA». Lo único que cambia es el gasto estimado, nunca lo que se cobra.
PRECIOS_IA=
