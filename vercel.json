{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/monthly-reset",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/alarmas-inactividad",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai/generate.ts": {
      "maxDuration": 90
    },
    "api/ai/stream.ts": {
      "maxDuration": 90
    },
    "api/ai/image.ts": {
      "maxDuration": 120
    },
    "api/ai/describe-image.ts": {
      "maxDuration": 60
    }
  }
}
